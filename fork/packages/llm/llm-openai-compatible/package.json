{
  "name": "@deepseek-ai/dsh-fork-llm-openai-compatible",
  "version": "0.0.1",
  "description": "Universal OpenAI-compatible LLM adapter for DeepSeek Harness (chat completions, streaming, model discovery). Provider route `openai-compatible`, settings namespace `llm-openai-compatible`. Uses any OpenAI-compatible endpoint (OpenRouter, NewAPI, vLLM, LM Studio, local servers).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "README.md",
    "README.zh.md",
    "tests"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "prepack": "npm run build",
    "build:host": "tsc -p tsconfig.json && node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run test:client && node tests/smoke.mjs",
    "test:client": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-fork-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-fork-llm": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.10"
  }
}
